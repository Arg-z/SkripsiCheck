SKRIPSICHECK_MIN_SEMANTIC_SCORE=0.40
SKRIPSICHECK_TOP_K_MATCHES=5
SKRIPSICHECK_MAX_UPLOAD_MB=25
SKRIPSICHECK_NGRAM_SIZE=5
SKRIPSICHECK_EMBEDDING_BATCH_SIZE=32
SKRIPSICHECK_DEVICE=cpu

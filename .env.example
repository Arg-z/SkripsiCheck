# SkripsiCheck local defaults. Copy to .env only when your launcher loads it;
# never commit .env or real credentials.
SKRIPSICHECK_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional local model directory. Vercel discovers deployment/model automatically.
# SKRIPSICHECK_SEMANTIC_MODEL_PATH=deployment/model
SKRIPSICHECK_LEXICAL_WEIGHT=0.35
SKRIPSICHECK_SEMANTIC_WEIGHT=0.45
SKRIPSICHECK_NGRAM_WEIGHT=0.20
SKRIPSICHECK_MIN_MATCH_SCORE=0.40
SKRIPSICHECK_MIN_SEMANTIC_SCORE=0.40
SKRIPSICHECK_TOP_K_MATCHES=5
SKRIPSICHECK_MAX_UPLOAD_MB=25
SKRIPSICHECK_MAX_ANALYSIS_CHARACTERS=1500000
SKRIPSICHECK_MAX_ANALYSIS_PARAGRAPHS=2000
SKRIPSICHECK_NGRAM_SIZE=5
SKRIPSICHECK_EMBEDDING_BATCH_SIZE=32
SKRIPSICHECK_DEVICE=cpu

# Local persistence.
SKRIPSICHECK_STORAGE_BACKEND=local
SKRIPSICHECK_UPLOAD_DIR=data/uploads
SKRIPSICHECK_INDEX_BACKEND=local
SKRIPSICHECK_INDEX_DIR=data/index
SKRIPSICHECK_DATABASE_URL=sqlite:///data/skripsicheck.sqlite3

# Hosted Vercel protected pilot (set in Vercel Project Settings, not this file).
# Uncommenting these locally changes the runtime architecture.
# SKRIPSICHECK_STORAGE_BACKEND=vercel_blob
# SKRIPSICHECK_INDEX_BACKEND=vercel_blob
# SKRIPSICHECK_BLOB_DOCUMENT_PREFIX=documents
# SKRIPSICHECK_BLOB_INDEX_PREFIX=indexes/current
# SKRIPSICHECK_INDEX_CACHE_DIR=/tmp/skripsicheck-index-cache
# SKRIPSICHECK_ACCESS_TOKEN=<unique-random-secret-at-least-32-characters>
# BLOB_READ_WRITE_TOKEN=<injected-when-private-blob-is-connected>

# Database resolution order is SKRIPSICHECK_DATABASE_URL, DATABASE_URL, then
# POSTGRES_URL. A connected Neon integration normally injects one of the latter
# two; use its pooled PostgreSQL URL. Never commit a real connection string.
# DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
# POSTGRES_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require

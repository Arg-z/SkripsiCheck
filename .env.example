SKRIPSICHECK_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SKRIPSICHECK_LEXICAL_WEIGHT=0.35
SKRIPSICHECK_SEMANTIC_WEIGHT=0.45
SKRIPSICHECK_NGRAM_WEIGHT=0.20
